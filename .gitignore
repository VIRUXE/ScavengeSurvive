#
# Package only files
#

# Compiled Bytecode, precompiled output and assembly
*.amx
*.lst
*.asm

# Dependency versions lockfile
pawn.lock
sampctl_build_file.inc

# Repository-local sampctl dependency overrides and generated cache
.sampctl-config/sampctl/*
!.sampctl-config/sampctl/dependency-overrides.json

#
# Server/gamemode related files
#

# compiled settings file
# keep `samp.json` file on version control
# but make sure the `rcon_password` field is set externally
# you can use the environment variable `SAMP_RCON_PASSWORD` to do this.
server.cfg
!server.cfg

# binaries
*.exe
!ss.exe
*.dll
*.so
!plugins/
!plugins/*.so
# open.mp server binary and its components
!omp-server
!components/
!components/*.so
announce
!announce

# logs
logs/
dist/
server_log.txt
crashinfo.txt
log.txt

# Ban list
samp.ban
bans.json

#
# Private resources
#

private/
gamemodes/sss/extensions/
gamemodes/ScavengeSurvive.tar.gz

# environment variables for development
.env

# stuff no one else needs
*.lnk
pyss/data/*.jpg
build-config.json

# Python stuff
__pycache__/
*.pyo
*.pyd
*$py.class
*.pyc

misc/config.json
*.mmd
misc/logmarkov.cfg

scriptfiles/geoip.db
scriptfiles/geoip_city.db
scriptfiles/SAfull.hmap
scriptfiles/SAfull.jpg
scriptfiles/txmap/
scriptfiles/logs/
scriptfiles/data/
scriptfiles/YSI/
scriptfiles/carmour/
scriptfiles/.gitignore
scriptfiles/.git/

# runner binaries
ScavengeSurvive.exe
ScavengeSurvive
